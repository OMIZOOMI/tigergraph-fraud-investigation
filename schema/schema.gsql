CREATE VERTEX Customer (
  PRIMARY_ID customer_id STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX Card (
  PRIMARY_ID card_id STRING,
  card_network STRING,
  card_type STRING
);

CREATE VERTEX Transaction (
  PRIMARY_ID txn_id STRING,
  amt DOUBLE,
  ts DATETIME,
  channel STRING,
  risk_score DOUBLE,
  product_cd STRING,
  addr1 STRING,
  addr2 STRING
);

CREATE VERTEX DeviceProfile (
  PRIMARY_ID profile_id STRING,
  device_info STRING,
  os STRING,
  browser STRING,
  screen STRING,
  device_type STRING
);

CREATE VERTEX EmailDomain (
  PRIMARY_ID domain STRING
);

CREATE VERTEX BillingRegion (
  PRIMARY_ID region_code STRING
);

CREATE VERTEX ClosedCase (
  PRIMARY_ID case_id STRING,
  customer_id STRING,
  card_id STRING,
  outcome STRING,
  pattern STRING,
  exposure_usd DOUBLE,
  report_filed BOOL,
  analyst_notes STRING
);

CREATE VERTEX InvestigationCase (
  PRIMARY_ID case_id STRING,
  status STRING,
  verdict STRING,
  fraud_probability DOUBLE,
  pattern STRING,
  pattern_description STRING,
  exposure_usd DOUBLE,
  summary STRING,
  written_to_graph BOOL,
  opened_at DATETIME,
  closed_at DATETIME
);

CREATE VERTEX PolicyDoc (
  PRIMARY_ID doc_id STRING,
  rule_id STRING,
  title STRING,
  content STRING
);

CREATE DIRECTED EDGE OWNS (
  FROM Customer,
  TO Card
);

CREATE DIRECTED EDGE MADE (
  FROM Card,
  TO Transaction
);

CREATE DIRECTED EDGE FROM_DEVICE (
  FROM Transaction,
  TO DeviceProfile
);

CREATE DIRECTED EDGE PURCHASER_EMAIL (
  FROM Transaction,
  TO EmailDomain
);

CREATE DIRECTED EDGE BILLED_IN (
  FROM Transaction,
  TO BillingRegion
);

CREATE DIRECTED EDGE NEXT_TRANSACTION (
  FROM Transaction,
  TO Transaction
);

CREATE DIRECTED EDGE INVOLVES (
  FROM ClosedCase,
  TO Transaction
);

CREATE DIRECTED EDGE ON_CARD (
  FROM ClosedCase,
  TO Card
);

CREATE DIRECTED EDGE CONNECTED_TO (
  FROM ClosedCase,
  TO Card
);

CREATE DIRECTED EDGE CASE_EVIDENCE_TXN (
  FROM InvestigationCase,
  TO Transaction
);

CREATE DIRECTED EDGE CASE_EVIDENCE_CARD (
  FROM InvestigationCase,
  TO Card
);

CREATE DIRECTED EDGE CASE_EVIDENCE_DEVICE (
  FROM InvestigationCase,
  TO DeviceProfile
);

CREATE GRAPH FraudGraph (*);
